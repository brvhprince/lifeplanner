# Where the SQLite database, uploads and generated keys live.
# In Docker this is /data (mount a volume there).
DATA_DIR=./data

# Time zone for due dates and reminder times (Docker defaults to UTC).
# TZ=Africa/Accra

# Optional: 32+ random bytes (hex or base64) used to encrypt sensitive fields
# such as 2FA secrets. If unset, one is generated in DATA_DIR/secret.key on
# first start. Back it up together with the database.
# APP_SECRET=

# Optional: session lifetime in days (default 30).
# SESSION_DAYS=30

# Set to "true" when served over HTTPS behind a reverse proxy that doesn't
# send X-Forwarded-Proto.
# COOKIE_SECURE=true

# Optional push notification keys (both or neither). If unset, they are
# generated in DATA_DIR/vapid.json. Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contact sent to push services (default: mailto:<owner email>).
# VAPID_SUBJECT=https://me.example.com
# Extra push service hosts to allow, comma-separated (rarely needed).
# PUSH_ALLOWED_HOSTS=
